# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used for canonical URLs, sitemap and structured data)
NEXT_PUBLIC_SITE_URL=https://www.theconvenientconcierge.ca

# MongoDB Atlas connection string (database user with readWrite on this database only)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Long random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Initial administrator (used only by `npm run create-admin`)
ADMIN_EMAIL=
# Argon2id hash, generate with: npm run hash-password -- "<your strong password>"
ADMIN_PASSWORD_HASH=

# Where new booking requests are emailed (optional, requires SMTP below)
BOOKING_NOTIFICATION_EMAIL=info@theconvenientconcierge.ca

# SMTP (optional). Leave blank to disable email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Max upload size in bytes. Keep at 4 MB (4194304) on Vercel: its functions reject request bodies over 4.5 MB.
# Raise (max 8388608) only on hosts whose proxy limit is verified to allow it.
MAX_UPLOAD_BYTES=4194304




